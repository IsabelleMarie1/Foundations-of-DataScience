  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "11fb751c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#alle Subtypen mit Nan entfernen \n",
    "combined_clean=combined.dropna(subset=[\"BRCA_subtype\"])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "e55cd565",
   "metadata": {},
   "outputs": [],
   "source": [
    "#kontrolle wie viele noch übrig nachdem zeilen Subtyp=nan noch übrig\n",
    "remaining_nans = combined_clean.isna().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "d2f0fcbb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Entferne die restlichen NaNs\n",
    "combined_clean = combined_clean.dropna()"
   ]
  },
