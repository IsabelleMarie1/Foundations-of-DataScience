   "source": [
    "from sklearn.decomposition import PCA\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Wir gehen davon aus, dass X_train, y_train und anova_selector bereits definiert sind\n",
    "# und anova_selector die Top-k-Gene (z.B. 400) ausgewählt hat.\n",
    "\n",
    "# Feature-selektierte Trainingsdaten\n",
    "X_train_fs = X_train.loc[:, selected_genes]\n",
    "\n",
    "# PCA auf den selektierten Genen\n",
    "pca = PCA(n_components=2, random_state=42)\n",
    "X_train_pca = pca.fit_transform(X_train_fs)\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(8, 6))\n",
    "subtype_colors = {\n",
    "    \"Basal\": \"#440154\",\n",
    "    \"Her2\": \"#414487\",\n",
    "    \"LumA\": \"#2A788E\",\n",
    "    \"LumB\": \"#22A884\",\n",
    "    \"Normal\": \"#7AD151\",\n",
    "}\n",
    "\n",
    "for subtype, color in subtype_colors.items():\n",
    "    mask = (y_train == subtype)\n",
    "    plt.scatter(\n",
    "        X_train_pca[mask, 0],\n",
    "        X_train_pca[mask, 1],\n",
    "        s=25,\n",
    "        alpha=0.8,\n",
    "        label=subtype,\n",
    "        color=color,\n",
    "    )\n",
    "\n",
    "plt.xlabel(\"PCA Component 1\", fontsize=18)\n",
    "plt.ylabel(\"PCA Component 2\", fontsize=18)\n",
    "plt.title(\"PCA of Selected Gene Features (Train Set)\", fontsize=20)\n",
    "plt.legend(title=\"BRCA subtype\", fontsize=17)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
