  {
   "cell_type": "markdown",
   "id": "7c95bcf3",
   "metadata": {},
   "source": [
    "### Imbalance beweisen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "f6c61783",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "ax = sns.countplot(\n",
    "    data=combined_clean, #weil die patienten ohne NaN nichts aussagen\n",
    "    x=\"BRCA_subtype\",\n",
    "    order=combined_clean[\"BRCA_subtype\"].value_counts().index\n",
    ")\n",
    "\n",
    "# Zahlen über Balken schreiben\n",
    "for container in ax.containers:\n",
    "    ax.bar_label(container)\n",
    "\n",
    "plt.title(\"Distribution of BRCA Subtypes\")\n",
    "plt.xlabel(\"BRCA Subtype\")\n",
    "plt.ylabel(\"Number of Patients\")\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "467f4d3b",
   "metadata": {},
   "source": [
    "### Varianzen prüfen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "36b6aaac",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Features und Label trennen\n",
    "X = combined_clean.drop(columns=[\"BRCA_subtype\"])\n",
    "y = combined_clean[\"BRCA_subtype\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "0560fdcb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Varianz jedes Gens berechnen\n",
    "variances = X.var()"
   ]
  },
