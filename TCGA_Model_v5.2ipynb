    "# ── Validation Curve für C (Regularisierung) ─────────────────────────────────\n",
    "# Zeigt Overfitting/Underfitting abhängig von der Regularisierungsstärke\n",
    "\n",
    "from sklearn.model_selection import validation_curve\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# C-Werte wie im GridSearch\n",
    "param_range = np.logspace(-3, 1, 8)\n",
    "\n",
    "# Validation Curve berechnen\n",
    "train_scores, val_scores = validation_curve(\n",
    "    LogisticRegression(\n",
    "        penalty=\"elasticnet\",\n",
    "        solver=\"saga\",\n",
    "        l1_ratio=best_l1_ratio,\n",
    "        max_iter=5000,\n",
    "        class_weight=\"balanced\"\n",
    "    ),\n",
    "    X_lum,\n",
    "    y_lum,\n",
    "    param_name=\"C\",\n",
    "    param_range=param_range,\n",
    "    cv=5,\n",
    "    scoring=\"balanced_accuracy\",\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "best_C_lum = param_range[np.argmax(val_scores.mean(axis=1))]\n",
    "\n",
    "# Mittelwerte\n",
    "train_mean = train_scores.mean(axis=1)\n",
    "train_std  = train_scores.std(axis=1)\n",
    "\n",
    "val_mean = val_scores.mean(axis=1)\n",
    "val_std  = val_scores.std(axis=1)\n",
    "\n",
    "# ── Plot ──────────────────────────────────────────────────────────────────────\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.semilogx(param_range, train_mean, linewidth=2, label=\"Training Score\")\n",
    "plt.semilogx(param_range, val_mean, linewidth=2, label=\"Validation Score\")\n",
    "\n",
    "plt.fill_between(\n",
    "    param_range,\n",
    "    train_mean - train_std,\n",
    "    train_mean + train_std,\n",
    "    alpha=0.2\n",
    ")\n",
    "\n",
    "plt.fill_between(\n",
    "    param_range,\n",
    "    val_mean - val_std,\n",
    "    val_mean + val_std,\n",
    "    alpha=0.2\n",
    ")\n",
    "\n",
    "plt.axvline(\n",
    "    best_C_lum,\n",
    "    linestyle=\"--\",\n",
    "    alpha=0.8,\n",
    "    label=f\"Best C = {best_C_lum}\"\n",
    ")\n",
    "\n",
    "plt.xlabel(\"C (inverse regularization strength)\")\n",
    "plt.ylabel(\"Balanced Accuracy\")\n",
    "plt.title(\"Validation Curve for Elastic Net Logistic Regression\")\n",
    "\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "\n",
    "plt.show()"
   ]
  },
