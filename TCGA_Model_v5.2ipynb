   "source": [
    "overview = pd.DataFrame({\n",
    "    \"variable\": combined_clean.columns,\n",
    "    \"dtype\": combined_clean.dtypes.astype(str).values,\n",
    "    \"n_unique\": [combined_clean[col].nunique() for col in combined_clean.columns]\n",
    "})\n",
    "\n",
    "display(overview)\n"
   ]
  },
