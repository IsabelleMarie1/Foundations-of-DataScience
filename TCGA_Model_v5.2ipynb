    "models_lc = {\n",
    "    \"LogReg L2\": pipe_l2,\n",
    "    \"Elastic Net\": pipe_en,\n",
    "    \"Random Forest\": pipe_rf,\n",
    "    \"SVM (linear)\": pipe_svm\n",
    "}\n",
    "\n",
    "train_sizes = np.linspace(0.1, 1.0, 5)  # 5 statt 8 Punkte\n",
    "cvstrategy_lc = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for ax, (name, model) in zip(axes, models_lc.items()):\n",
    "    plot_learning_curve(\n",
    "        estimator=model,\n",
    "        X=X_train,\n",
    "        y=y_train,\n",
    "        cv=cvstrategy_lc,\n",
    "        scorer=\"balanced_accuracy\",\n",
    "        train_sizes=train_sizes,\n",
    "        title=name,\n",
    "        ax=ax,\n",
    "        n_jobs=-1,\n",
    "    )\n",
    "\n",
    "plt.suptitle(\"Learning Curves (fixed hyperparameters)\", fontsize=16)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
