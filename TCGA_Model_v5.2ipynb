       "1     Stratified sampling                 0.008421"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#Vergleiche anzeigen\n",
    "comparison = pd.DataFrame({\n",
    "    \"method\": [\"Simple random sampling\", \"Stratified sampling\"],\n",
    "    \"mean_distribution_error\": [simple_mean_error, strat_mean_error]\n",
    "})\n",
    "\n",
    "display(comparison)\n",
    "\n",
    "#Stratified sampling erhält die ursprüngliche Subtyp-Verteilung besser."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "3cf79958",
   "metadata": {},
   "outputs": [
