   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "c745bc3c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#finaler Analyse Datensatz --> cleaned (OHNE VAR=0 & OHNE NANs)\n",
    "analysis = combined_no_constant.copy()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "58f61d80",
   "metadata": {},
   "source": [
    "### Sampling vergleichen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "55f94ea3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.microsoft.datawrangler.viewer.v0+json": {
       "columns": [
        {
         "name": "BRCA_subtype",
         "rawType": "str",
         "type": "string"
        },
        {
         "name": "proportion",
         "rawType": "float64",
         "type": "float"
        }
       ],
       "ref": "95913239-248e-4bb5-88f1-3e90740f63e4",
       "rows": [
        [
         "Basal",
         "0.1463157894736842"
        ],
        [
         "Her2",
         "0.07052631578947369"
        ],
        [
         "LumA",
         "0.4557894736842105"
        ],
        [
         "LumB",
         "0.20210526315789473"
        ],
        [
         "Normal",
         "0.12526315789473685"
        ]
       ],
       "shape": {
        "columns": 1,
        "rows": 5
       }
      },
      "text/plain": [
       "BRCA_subtype\n",
       "Basal     0.146316\n",
       "Her2      0.070526\n",
       "LumA      0.455789\n",
       "LumB      0.202105\n",
       "Normal    0.125263\n",
       "Name: proportion, dtype: float64"
      ]
     },
     "execution_count": 26,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "target = \"BRCA_subtype\"\n",
    "sample_frac = 0.2\n",
    "n_repeats = 500\n",
    "\n",
    "#normalize = True: wandelt absolute count in relative Häufigkeiten/ Anteile um\n",
    "#Proportion=Anzahl Subtyp​/Gesamtzahl Patienten\n",
    "#sort_index: sortiert alphabetisch nach labelnamen\n",
    "original_props = analysis[target].value_counts(normalize=True).sort_index()\n",
    "original_props\n",
    "\n",
    "#Output: Propotinalen Anteile jedes Subtypens im gesamten Datensatz"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "ab21a820",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "np.float64(0.0950778947368421)"
      ]
     },
     "execution_count": 27,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#Simple Random Sampling mehrfach testen \n",
    "#misst wie stark weicht die Subtypen verteilung im Sample vom Original ab\n",
    "simple_errors = []\n",
    "\n",
    "for i in range(n_repeats):\n",
    "    sample = analysis.sample(frac=sample_frac, random_state=i)\n",
    "    sample_props = sample[target].value_counts(normalize=True).reindex(original_props.index, fill_value=0)\n",
    "    #berechnet die Subtypen Proportionen des Samples\n",
    "    error = (sample_props - original_props).abs().sum() #Wie stark weicht jede Klasse ab, abs. = absoluter wert\n",
    "    simple_errors.append(error)\n",
    "\n",
    "simple_mean_error = np.mean(simple_errors)# durchschnittliccher Sampling-Fehler\n",
    "simple_mean_error\n",
    "\n",
    "#Output: Im Durchschnitt weicht ein einfach zufällig gezogenes Sample \n",
    "# um etwa 9.5 Prozentpunkte Gesamtverteilung von der \n",
    "# ursprünglichen Subtyp-Verteilung ab."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "48adb589",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "np.float64(0.008421052631578899)"
      ]
     },
     "execution_count": 28,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "#stratefied sampling mehrfach testen\n",
    "##misst wie stark weicht die Subtypen verteilung im Sample vom Original ab\n",
    "strat_errors = []\n",
    "\n",
    "for i in range(n_repeats):\n",
    "    sample = (\n",
    "        analysis\n",
    "        .groupby(target, group_keys=False)\n",
    "        .sample(frac=sample_frac, random_state=i)\n",
    "    )\n",
    "    \n",
    "    sample_props = sample[target].value_counts(normalize=True).reindex(original_props.index, fill_value=0)\n",
    "    error = (sample_props - original_props).abs().sum()\n",
    "    strat_errors.append(error)\n",
    "\n",
    "strat_mean_error = np.mean(strat_errors)\n",
    "strat_mean_error\n",
    "\n",
    "#Output: Die Verteilung eines stratified samples weicht im Durchschnitt nur um 0.79 Prozentpunkte Gesamtverteilung vom Originaldatensatz ab."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "41eda4a5",
   "metadata": {},
   "outputs": [
    {
     "data": {
