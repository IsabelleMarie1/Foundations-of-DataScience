    "from sklearn.model_selection import learning_curve\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "cvstrategy = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "def plot_learning_curve(\n",
    "    estimator,\n",
    "    X,\n",
    "    y,\n",
    "    cv,\n",
    "    scorer=\"balanced_accuracy\",\n",
    "    train_sizes=np.linspace(0.1, 1.0, 5),\n",
    "    title=None,\n",
    "    ax=None,\n",
    "    n_jobs=-1\n",
    "):\n",
    "    \"\"\"\n",
    "    Zeichnet eine Learning Curve für ein gegebenes Modell.\n",
    "\n",
    "    estimator : Pipeline oder Estimator (ohne *CV-Varianten, falls möglich)\n",
    "    X, y      : Trainingsdaten\n",
    "    cv        : Cross-Validation-Strategie (z.B. StratifiedKFold)\n",
    "    scorer    : Scoring-Name (z.B. 'balanced_accuracy')\n",
    "    train_sizes : Array von relativen Trainingsgrößen\n",
    "    title     : Plot-Titel (Str)\n",
    "    ax        : Matplotlib-Achse; wenn None, wird eine neue erzeugt\n",
    "    n_jobs    : Anzahl Jobs für learning_curve\n",
    "    \"\"\"\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(6, 4))\n",
    "\n",
    "    sizes, train_scores, val_scores = learning_curve(\n",
    "        estimator=estimator,\n",
    "        X=X_train,\n",
    "        y=y_train,\n",
    "        cv=cvstrategy,\n",
    "        scoring=scorer,\n",
    "        train_sizes=train_sizes,\n",
    "        n_jobs=n_jobs,\n",
    "    )\n",
    "\n",
    "    train_mean = train_scores.mean(axis=1)\n",
    "    train_std  = train_scores.std(axis=1)\n",
    "    val_mean   = val_scores.mean(axis=1)\n",
    "    val_std    = val_scores.std(axis=1)\n",
    "\n",
    "    ax.plot(sizes, train_mean, marker=\"o\", linewidth=2, label=\"Training Score\")\n",
    "    ax.plot(sizes, val_mean,  marker=\"o\", linewidth=2, label=\"Validation Score\")\n",
    "\n",
    "    ax.fill_between(\n",
    "        sizes,\n",
    "        train_mean - train_std,\n",
    "        train_mean + train_std,\n",
    "        alpha=0.2\n",
    "    )\n",
    "    ax.fill_between(\n",
    "        sizes,\n",
    "        val_mean - val_std,\n",
    "        val_mean + val_std,\n",
    "        alpha=0.2\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\"Training Set Size\")\n",
    "    ax.set_ylabel(scorer.replace(\"_\", \" \").title())\n",
    "    if title is not None:\n",
    "        ax.set_title(title)\n",
    "    ax.grid(True, alpha=0.3)\n",
    "    ax.legend()\n",
    "\n",
    "    return ax"
   ]
  },
